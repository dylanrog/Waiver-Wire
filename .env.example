# Copy to .env.local. Validated at startup by packages/shared/src/env.ts.
# Worktrees do not inherit this file — scripts/bootstrap.sh copies it for you.

# --- Database (Supabase) ---
# Settings → Database → Connection string → URI. Use the pooled (6543) URL for the app.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Direct (5432) connection, required for Drizzle migrations.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- LLM ---
# Used only for ranking extraction and explanation prose. Never for math.
ANTHROPIC_API_KEY="sk-ant-..."

# --- App ---
NFL_SEASON="2026"
# Sent on every outbound scrape. Use something identifiable, not a browser string.
FETCH_USER_AGENT="waiver-wire/0.1 (personal fantasy tool; contact: you@example.com)"
# Set true to serve every source read from raw_fetches and never hit the network.
# Post-MVP demo mode uses this; useful now for offline development.
OFFLINE_MODE="false"
